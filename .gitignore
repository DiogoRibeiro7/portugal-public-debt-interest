.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tmp/
.tmp-next/
.coverage
htmlcov/
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
reports/figures/*
!reports/figures/.gitkeep
# The manuscripts \includegraphics these. Ignoring them meant a fresh clone
# could not build either paper -- which is the one thing a reproducibility
# paper must not get wrong. They are byte-reproducible (see plotting._save),
# so tracking them does not churn the history. PNG and SVG stay ignored:
# nothing consumes them and they are regenerated by `pt-debt plot`.
!reports/figures/*.pdf
reports/summary.md
reports/validation.json
reports/eurostat_panel_missingness.csv
reports/refinancing_scenarios.csv
reports/source_coverage.csv
reports/reproducibility.json

# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
